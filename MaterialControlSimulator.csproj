<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <BaseOutputPath>D:\Dev\MaterialSimulator</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="MaterialDesignInXamlToolkitAddOns" Version="0.0.63" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SimulationType\EL_1.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Simulator.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Plc\Logic\G2_Carrier Management\" />
    <Folder Include="Plc\Logic\C2_State Management\" />
    <Folder Include="Plc\Logic\G1_Material Management\" />
    <Folder Include="Plc\Logic\G4_Cell Management\" />
    <Folder Include="Plc\Logic\G6_Equipment UBM Parts Management\" />
    <Folder Include="Plc\Logic\T3_Transfer Management\" />
    <Folder Include="Plc\Logic\T2_Active Machine State Management\" />
    <Folder Include="Plc\Logic\T1_Passive Machine State Management\" />
  </ItemGroup>

</Project>
