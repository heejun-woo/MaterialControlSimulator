<UserControl
    x:Class="MaterialControlSimulator.Controls.CommunicationStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="12"
        CornerRadius="8"
        Background="#202830"
        BorderBrush="#53606C"
        BorderThickness="2">

        <StackPanel Orientation="Horizontal">

            <Ellipse
                x:Name="StatusLamp"
                Width="18"
                Height="18"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Fill="Gray"/>

            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="White"
                FontSize="14"
                FontWeight="SemiBold"
                Text="OFF"/>

        </StackPanel>

    </Border>

</UserControl>