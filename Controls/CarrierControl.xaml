<UserControl x:Class="MaterialControlSimulator.Controls.CarrierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaterialControlSimulator.Controls"
             mc:Ignorable="d" 
             Width="60" Height="60" IsHitTestVisible="False">
    <Grid>

        <!-- Carrier 본체 -->
        <Border
            Margin="3"
            Background="#252A30"
            BorderBrush="#66727D"
            BorderThickness="2"
            CornerRadius="6">

            <Grid>

                <!-- 바닥 트레이 -->
                <Border
                    Margin="9,12,9,15"
                    Background="#161A1E"
                    BorderBrush="#8A959F"
                    BorderThickness="2"
                    CornerRadius="3">

                    <Grid>

                        <!-- 빈 캐리어 표시 -->
                        <Grid>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsNotEmpty,
                                                RelativeSource={
                                                    RelativeSource AncestorType=UserControl}}"
                                            Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- 빈 트레이 내부 -->
                            <Rectangle
                                Margin="5"
                                Stroke="#59646E"
                                StrokeThickness="1"
                                StrokeDashArray="3 2"/>

                            <TextBlock
                                Text="EMPTY"
                                Foreground="#7F8A94"
                                FontSize="7"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <!-- 제품 적재 표시 -->
                        <Grid>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsNotEmpty,
                                                RelativeSource={
                                                    RelativeSource AncestorType=UserControl}}"
                                            Value="false">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!-- 제품 -->
                            <Border
                                Margin="5"
                                Background="#C78332"
                                BorderBrush="#F1B45C"
                                BorderThickness="1"
                                CornerRadius="2">

                                <Grid>

                                    <!-- 제품 윗면 -->
                                    <Polygon
                                        Points="8,3 27,3 32,7 13,7"
                                        Fill="#E2A14B"/>

                                    <!-- 제품 -->
                                    <TextBlock
                                        Text="P"
                                        Foreground="#FFF1D0"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>


                <!-- Carrier ID -->
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#303840"
                    Padding="4,1"
                    CornerRadius="3">

                    <TextBlock
                        Text="{Binding Id,
                            RelativeSource={
                                RelativeSource AncestorType=UserControl}}"
                        Foreground="White"
                        FontSize="8"
                        FontWeight="Bold"/>

                </Border>

            </Grid>

        </Border>

    </Grid>
</UserControl>
