<UserControl x:Class="MaterialControlSimulator.Controls.CarrierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaterialControlSimulator.Controls"
             mc:Ignorable="d" 
             Width="60" Height="60" IsHitTestVisible="False" >
    <Border
        CornerRadius="6"
        Background="#202830"
        BorderBrush="#00B8D4"
        BorderThickness="2">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Carrier ID -->
            <Viewbox
                Grid.Row="0"
                Stretch="Uniform"
                StretchDirection="DownOnly"
                Margin="3,4">

                            <TextBlock
                    Text="{Binding Id,
                        RelativeSource={RelativeSource AncestorType=local:CarrierControl}}"
                    Foreground="White"
                    FontSize="11"
                    FontWeight="Bold"
                    FontFamily="Consolas"
                    TextAlignment="Center"/>

            </Viewbox>

            <!-- 구분선 -->
            <Border
                Grid.Row="1"
                Background="#53606C"
                Margin="4,0"/>

            <!-- Cell 수량 -->
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="Bold">

                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}/{1}">
                        <Binding
                            Path="CurrentCellCount"
                            RelativeSource="{RelativeSource AncestorType=local:CarrierControl}"/>

                        <Binding
                            Path="MaxCellCount"
                            RelativeSource="{RelativeSource AncestorType=local:CarrierControl}"/>
                    </MultiBinding>
                </TextBlock.Text>

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter
                            Property="Foreground"
                            Value="#FFD15C"/>

                        <!-- Empty -->
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding CurrentCellCount,
                                    RelativeSource={RelativeSource AncestorType=local:CarrierControl}}"
                                Value="0">

                                <Setter
                                    Property="Foreground"
                                    Value="#5DE7F5"/>

                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </Grid>

    </Border>
</UserControl>
