<UserControl x:Class="MaterialControlSimulator.Controls.CarrierControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaterialControlSimulator.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="40">
    <Grid>

        <Border
            Background="#00C853"
            CornerRadius="5"/>

        <TextBlock
            Text="{Binding Id, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

    </Grid>
</UserControl>
