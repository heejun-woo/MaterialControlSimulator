<UserControl x:Class="MaterialControlSimulator.Controls.HMI.LS_PKG_EL1_LEAK_CHECKER"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaterialControlSimulator.Controls.HMI">

    <UserControl.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#E8EAED"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F2F3F5" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="#343A40"
                Padding="16,12"
                Margin="0,0,0,8" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="1st EL Filling_01_Leak Checker"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Equipment Control"
                               Foreground="#C8CDD2"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="20,0">
                    <TextBlock Text="COMM"
                               Foreground="#ADB5BD"/>
                    <TextBlock x:Name="CommStatusText"
                               Text="● ONLINE"
                               Foreground="#69DB7C"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="20,0">
                    <TextBlock Text="MODE"
                               Foreground="#ADB5BD"/>
                    <TextBlock x:Name="ModeStatusText"
                               Text="AUTO"
                               Foreground="White"
                               FontWeight="Bold"/>
                </StackPanel>

                <Border Grid.Column="3"
                        Background="#495057"
                        Padding="20,10">
                    <TextBlock x:Name="RunStatusText"
                               Text="STOP"
                               Foreground="White"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- HMI SCREENS -->
        <TabControl Grid.Row="1" Grid.ColumnSpan="2">

            <TabItem Header="IT MAIN">
                <local:LS_PKG_EL1_LEAK_CHECKER_Main
                    x:Name="MainControl"/>
            </TabItem>

            <TabItem Header="ALARM LIST">
                <local:LS_PKG_EL1_LEAK_CHECKER_Main
                    x:Name="AlarmControl"/>
            </TabItem>

            <!--<TabItem Header="HOST MESSAGE">
                <local:HostMessageControl
                    x:Name="HostMessageControl"/>
            </TabItem>-->

            <!--<TabItem Header="UBM LIST">
                <local:UbmListControl
                    x:Name="UbmControl"/>
            </TabItem>-->

            <!--<TabItem Header="PORT MGR">
                <local:PortManagerControl
                    x:Name="PortManagerControl"/>
            </TabItem>-->

        </TabControl>
    </Grid>

</UserControl>
