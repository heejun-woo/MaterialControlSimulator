<UserControl x:Class="MaterialControlSimulator.Controls.HMI.LS_PKG_EL1_LEAK_CHECKER_Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaterialControlSimulator.Controls.HMI">
    
    <UserControl.Resources>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="65"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#343A40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="#E1E5E8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HmiButton" TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F2F3F5" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LOT INFORMATION -->
        <Border Background="White"
                BorderBrush="#D5D8DC"
                BorderThickness="1"
                Padding="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="LOT INFORMATION"
                           FontSize="17"
                           FontWeight="Bold"/>

                <Grid Grid.Row="1" Margin="0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- NEXT LOT -->
                    <GroupBox Header="NEXT LOT"                      
                              MinHeight="80">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="LOT ID"
                               Margin="0,5"
                               VerticalAlignment="Center"
                               Style="{StaticResource LabelText}"/>

                            <TextBlock x:Name="NextLotId"
                               Grid.Column="1"
                               Text="NEXT LOT ID"
                               Margin="0,3"
                               Style="{StaticResource ValueText}"/>

                            <TextBlock Grid.Row="1"
                               Text="MODEL"
                               Margin="0,5"
                               VerticalAlignment="Center"
                               Style="{StaticResource LabelText}"/>

                            <TextBlock x:Name="NextModel"
                               Grid.Row="1"
                               Grid.Column="1"
                               Text="MODEL-A"
                               Margin="0,3"
                               Style="{StaticResource ValueText}"/>

                            <TextBlock Grid.Row="2"
                               Text="-"
                               Margin="0,5"
                               VerticalAlignment="Center"
                               Style="{StaticResource LabelText}"/>

                            <TextBlock x:Name="NextQty"
                               Grid.Row="2"
                               Grid.Column="1"
                               Text=""
                               Margin="0,3"
                               Style="{StaticResource ValueText}"/>
                        </Grid>
                    </GroupBox>

                    <!-- CURRENT LOT -->
                    <GroupBox Grid.Column="2"
                      Header="CURRENT LOT"
                      MinHeight="80">

                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="LOT ID"
                               Margin="0,5"
                               VerticalAlignment="Center"
                               Style="{StaticResource LabelText}"/>

                            <TextBlock x:Name="CurrentLotId"
                               Grid.Column="1"
                               Text="CURRENT-LOT-001"
                               Margin="0,3"
                               Style="{StaticResource ValueText}"/>

                            <TextBlock Grid.Row="1"
                               Text="MODEL"
                               Margin="0,5"
                               VerticalAlignment="Center"
                               Style="{StaticResource LabelText}"/>

                            <TextBlock x:Name="CurrentModel"
                               Grid.Row="1"
                               Grid.Column="1"
                               Text="MODEL-A"
                               Margin="0,3"
                               Style="{StaticResource ValueText}"/>

                            <TextBlock Grid.Row="2"
                               Text="QTY"
                               Margin="0,5"
                               VerticalAlignment="Center"
                               Style="{StaticResource LabelText}"/>

                            <TextBlock x:Name="CurrentQty"
                               Grid.Row="2"
                               Grid.Column="1"
                               Text=""
                               Margin="0,3"
                               Style="{StaticResource ValueText}"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- LOT BUTTONS -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="LotInfoButton"
                            Content="LOT INFO"
                            Click="LotInfoButton_Click"
                            Style="{StaticResource HmiButton}"/>

                    <Button x:Name="LotStartButton"
                            Content="LOT START"
                            Click="LotStartButton_Click"
                            Style="{StaticResource HmiButton}"/>

                    <Button x:Name="LotEndButton"
                            Content="LOT END"
                            Click="LotEndButton_Click"
                            Style="{StaticResource HmiButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MATERIAL -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D5D8DC"
                BorderThickness="1"
                Padding="15">

            <StackPanel>
                <TextBlock Text="MATERIAL / CARRIER"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- BCR -->
                    <TextBlock Grid.Row="0"
                               Text="BCR"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="MaterialBcr"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,3"
                             Padding="8,4"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"/>
                    
                    <!-- MATERIAL LOT ID -->
                    <TextBlock Grid.Row="1"
                               Text="MATERIAL LOT ID"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="MaterialLotId"
                               Grid.Row="1"
                               Grid.Column="1"
                               Text="-"
                               Style="{StaticResource ValueText}"/>


                    <!-- SEPA SP1 -->
                    <TextBlock Grid.Row="2"
                               Text="SEPA SP1"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="SepaSp1"
                               Grid.Row="2"
                               Grid.Column="1"
                               Text="0"
                               Style="{StaticResource ValueText}"/>
                    
                    <Button x:Name="ForceOutButton"
                                Grid.Row="2"
                                Grid.Column="2"
                                Content="FORCE OUT"
                                Click="ForceOutButton_Click"
                                Style="{StaticResource HmiButton}"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
