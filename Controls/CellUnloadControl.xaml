<local:NodeControl
    x:Class="MaterialControlSimulator.Controls.CellUnloadControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MaterialControlSimulator.Controls"  
    Width="80"
    Height="80">

    <Border
        CornerRadius="7"
        Background="#202830"
        BorderBrush="#FFB74D"
        BorderThickness="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="UNLOAD"
                Foreground="White"
                FontSize="9"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <TextBlock
                Grid.Row="1"
                Text="▼"
                Foreground="#FFB74D"
                FontSize="22"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <TextBlock
                Grid.Row="2"
                  Text="{Binding Id,
      RelativeSource={RelativeSource AncestorType=local:NodeControl}}"
                   
                Foreground="#CFD8DC"
                FontSize="8"
                HorizontalAlignment="Center"/>
        </Grid>
    </Border>

</local:NodeControl>