<local:NodeControl
    x:Class="MaterialControlSimulator.Controls.PortControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MaterialControlSimulator.Controls">
    <Grid>
        <Border Background="Blue"
            Width="50"
            Height="50"/>
        <TextBlock
            Text="{Binding Id, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
    </Grid>

</local:NodeControl>
