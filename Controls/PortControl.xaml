<local:NodeControl
    x:Class="MaterialControlSimulator.Controls.PortControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MaterialControlSimulator.Controls">
    <Grid>

        <!-- 외곽 -->
        <Border x:Name="NodeBorder"
            CornerRadius="8"
            Background="#202830"
            BorderBrush="#00B8D4"
            BorderThickness="2">

            <Border.Style>

                <Style TargetType="Border">

                    <Setter Property="BorderBrush"
                        Value="#53606C"/>

                    <Setter Property="BorderThickness"
                        Value="2"/>

                </Style>

            </Border.Style>

            <Grid>

                <!-- 포트 표시 -->
                <Ellipse
    Width="42"
    Height="42"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    StrokeThickness="2">

                    <Ellipse.Style>

                        <Style TargetType="Ellipse">

                            <!-- 0 : 기본 -->
                            <Setter Property="Fill"
                    Value="#182329"/>

                            <Setter Property="Stroke"
                    Value="#53606C"/>

                            <Style.Triggers>

                                <!-- 1 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="1">

                                    <Setter Property="Fill"
                            Value="#123A32"/>

                                    <Setter Property="Stroke"
                            Value="#00E676"/>

                                </DataTrigger>

                                <!-- 2 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="2">

                                    <Setter Property="Fill"
                            Value="#15334A"/>

                                    <Setter Property="Stroke"
                            Value="#40C4FF"/>

                                </DataTrigger>

                                <!-- 3 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="3">

                                    <Setter Property="Fill"
                            Value="#40351A"/>

                                    <Setter Property="Stroke"
                            Value="#FFC107"/>

                                </DataTrigger>

                                <!-- 4 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="4">

                                    <Setter Property="Fill"
                            Value="#421D23"/>

                                    <Setter Property="Stroke"
                            Value="#FF5252"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Ellipse.Style>

                </Ellipse>
                <Ellipse
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    StrokeThickness="2">

                    <Ellipse.Style>

                        <Style TargetType="Ellipse">

                            <!-- 0 : 기본 -->
                            <Setter Property="Fill"
                    Value="#182329"/>

                            <Setter Property="Stroke"
                    Value="#53606C"/>

                            <Style.Triggers>

                                <!-- 1 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="1">

                                    <Setter Property="Fill"
                            Value="#123A32"/>

                                    <Setter Property="Stroke"
                            Value="#00E676"/>

                                </DataTrigger>

                                <!-- 2 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="2">

                                    <Setter Property="Fill"
                            Value="#15334A"/>

                                    <Setter Property="Stroke"
                            Value="#40C4FF"/>

                                </DataTrigger>

                                <!-- 3 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="3">

                                    <Setter Property="Fill"
                            Value="#40351A"/>

                                    <Setter Property="Stroke"
                            Value="#FFC107"/>

                                </DataTrigger>

                                <!-- 4 -->
                                <DataTrigger
                    Binding="{Binding PortState,
                        RelativeSource={RelativeSource AncestorType=local:PortControl}}"
                    Value="4">

                                    <Setter Property="Fill"
                            Value="#421D23"/>

                                    <Setter Property="Stroke"
                            Value="#FF5252"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Ellipse.Style>

                </Ellipse>

                <!-- 입출고 방향 표시 -->
                <Path
                    Data="M 25,40 L 40,25 L 55,40"
                    Stroke="#5DE7F5"
                    StrokeThickness="3"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <!-- ID -->
                <TextBlock
                    Text="{Binding Id,
                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Foreground="White"
                    FontSize="11"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,6"/>


            </Grid>

        </Border>

    </Grid>

</local:NodeControl>
