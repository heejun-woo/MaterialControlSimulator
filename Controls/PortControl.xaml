<local:NodeControl
    x:Class="MaterialControlSimulator.Controls.PortControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MaterialControlSimulator.Controls">
    <Grid>

        <!-- 외곽 -->
        <Border
            CornerRadius="8"
            Background="#202830"
            BorderBrush="#00B8D4"
            BorderThickness="2">

            <Grid>

                <!-- 포트 표시 -->
                <Ellipse
                    Width="42"
                    Height="42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="#182329"
                    Stroke="#00B8D4"
                    StrokeThickness="2"/>

                <!-- 입출고 방향 표시 -->
                <Path
                    Data="M 25,40 L 40,25 L 55,40"
                    Stroke="#5DE7F5"
                    StrokeThickness="3"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <!-- ID -->
                <TextBlock
                    Text="{Binding Id,
                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Foreground="White"
                    FontSize="11"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,6"/>

            </Grid>

        </Border>

    </Grid>

</local:NodeControl>
