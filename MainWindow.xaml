<Window xmlns:MaterialControlSimulator="clr-namespace:MaterialControlSimulator"  xmlns:local="clr-namespace:MaterialControlSimulator.Controls" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
    x:Class="MaterialControlSimulator.MainWindow"
    Title="Factory Control"
    Width="1600"
    Height="900"
    Background="#1E1E1E">



    <Grid Margin="10" av:IsLocked="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- 상단 -->
        <Border
            Grid.ColumnSpan="3"
            Background="#2A2A2A"
            CornerRadius="8" av:IsLocked="True">

            <DockPanel Margin="15" av:IsLocked="True">

                <TextBlock
                    Text="SMART FACTORY CONTROL"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    VerticalAlignment="Center" av:IsLocked="True"/>

                <StackPanel
                    Orientation="Horizontal"
                    DockPanel.Dock="Right" av:IsLocked="True">

                    <Border
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Background="#00D26A"
                        Margin="0,0,8,0" av:IsLocked="True"/>

                    <TextBlock
                        Text="ONLINE"
                        Foreground="White"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0" av:IsLocked="True"/>

                    <TextBlock
                        Text="2026-08-05 14:32:15"
                        Foreground="White"
                        VerticalAlignment="Center" av:IsLocked="True"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- 좌측 설비 -->
        <Border
            Grid.Row="1"
            Margin="0,10,10,10"
            Background="#2A2A2A"
            CornerRadius="8" av:IsLocked="True">

            <StackPanel Margin="15" av:IsLocked="True">

                <TextBlock
                    Text="Equipment"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White" av:IsLocked="True"/>

                <ListBox Margin="0,15,0,0" av:IsLocked="True">

                    <ListBoxItem Content="PORT 01" av:IsLocked="True"/>
                    <ListBoxItem Content="PORT 02" av:IsLocked="True"/>
                    <ListBoxItem Content="PORT 03" av:IsLocked="True"/>
                    <ListBoxItem Content="ROBOT 01" av:IsLocked="True"/>
                    <ListBoxItem Content="ROBOT 02" av:IsLocked="True"/>
                    <ListBoxItem Content="STOCKER" av:IsLocked="True"/>
                    <ListBoxItem Content="CONVEYOR" av:IsLocked="True"/>

                </ListBox>

            </StackPanel>

        </Border>

        <!-- 중앙 -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,10"
            Background="#262626"
            CornerRadius="8" av:IsLocked="True">

            <Canvas x:Name="MapCanvas">

                <local:PortControl      
                    x:Name="Port01"  
                    Id="Port01"      
                    Canvas.Left="100"        
                    Canvas.Top="200"/>

                <local:PortControl      
                    x:Name="Port02" 
                    Id="Port02"
                    Canvas.Left="220"       
                    Canvas.Top="200"/>

                <local:PortControl      
                    x:Name="Port03" 
                    Id="Port03"       
                    Canvas.Left="220"       
                    Canvas.Top="300"/>

                <local:PortControl      
                    x:Name="Port04"                     
                    Id="Port04"
                    Canvas.Left="340"       
                    Canvas.Top="300"/>

                <local:CarrierControl        
                    x:Name="Carrier01"                     
                    Id="C01"      
                    Canvas.Left="0"     
                    Canvas.Top="200"/>
            </Canvas>

        </Border>

        <!-- 우측 -->
        <Border
            Grid.Row="1"
            Grid.Column="2"
            Margin="10,10,0,10"
            Background="#2A2A2A"
            CornerRadius="8" av:IsLocked="True">

            <DockPanel Margin="15" av:IsLocked="True">

                <TextBlock
                    DockPanel.Dock="Top"
                    Text="Alarm"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White" av:IsLocked="True"/>

                <DataGrid Margin="0,15,0,0" av:IsLocked="True"/>

            </DockPanel>

        </Border>

        <!-- 하단 -->
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Background="#2A2A2A"
            CornerRadius="8" av:IsLocked="True">

            <DockPanel Margin="15" av:IsLocked="True">

                <TextBlock
                    DockPanel.Dock="Top"
                    Text="System Log"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White" av:IsLocked="True"/>

                <ListBox Margin="0,15,0,0" av:IsLocked="True">

                    <ListBoxItem Content="[14:31:02] Robot Move Complete" av:IsLocked="True"/>
                    <ListBoxItem Content="[14:31:10] Port01 Load" av:IsLocked="True"/>
                    <ListBoxItem Content="[14:31:25] Carrier Arrived" av:IsLocked="True"/>
                    <ListBoxItem Content="[14:31:32] Alarm Reset" av:IsLocked="True"/>

                </ListBox>

            </DockPanel>

        </Border>

    </Grid>

</Window>