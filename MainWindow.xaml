<Window xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"  
        xmlns:MaterialControlSimulator="clr-namespace:MaterialControlSimulator"  
        xmlns:local="clr-namespace:MaterialControlSimulator.Controls" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="av"
        x:Class="MaterialControlSimulator.MainWindow"
        Title="Material Control Simulator"
        Width="1700"
        Height="900"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">


    <DockPanel>

        <!-- 메뉴 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File"/>
            <MenuItem Header="_Simulation"/>
            <MenuItem Header="_View"/>
            <MenuItem Header="_Tools"/>
        </Menu>

        <!-- 툴바 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <local:CommunicationStatusControl x:Name="CommStatus" Width="140" Height="50"/>
                
                <Button Content="▶ Start" Click="Start_Click"/>
                <Button Content="⏸ Pause" Click="Pause_Click"/>

                <Separator/>

                <Button Content="ReSet" Click="ZoomReset"/>
                <Button Content="+" Click="ZoomIn"/>
                <Button Content="-" Click="ZoomOut"/>
                
                <Separator/>

                <Button Content="Carrier 생성" Click="CreateCarrier_Click"/>
                <Button Content="Carrier 목적지 지정" Click="SetCarrierDestination_Click"/>
                <Button Content="Carrier 이력 조회" Click="CarrierHistoryWindows_Click"/>

            </ToolBar>
        </ToolBarTray>

        <!-- 상태바 -->
        <StatusBar DockPanel.Dock="Bottom">

            <TextBlock Text="Ready"/>

            <Separator/>

            <TextBlock Text="Zoom : 100%"/>

            <Separator/>

            <TextBlock Text="Carrier : 0"/>

            <Separator/>

            <TextBlock Text="Simulation : Stop"/>

        </StatusBar>

        <!-- 본문 -->
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- 기존 Equipment / Canvas / Property 영역 -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측 Equipment -->
                <GroupBox Header="Equipment"      
                      Grid.Column="0"        
                      Margin="5">

                    <DockPanel>

                        <TextBox DockPanel.Dock="Top"           
                             Margin="5"               
                             Height="28"/>

                        <TreeView x:Name="EquipmentTree"
                              SelectedItemChanged="EquipmentTree_SelectedItemChanged"
                              Background="Transparent"
                              BorderThickness="0">

                            <TreeView.ItemTemplate>

                                <HierarchicalDataTemplate
                                        ItemsSource="{Binding Items}">

                                    <TextBlock
                                        Text="{Binding Name}"
                                        Foreground="White"
                                        FontWeight="Bold"/>

                                </HierarchicalDataTemplate>

                            </TreeView.ItemTemplate>

                        </TreeView>

                    </DockPanel>

                </GroupBox>

                <!-- 가운데 Simulation -->
                <GroupBox Header="Simulation"         
                      Grid.Column="1"         
                      Margin="5">

                    <ScrollViewer x:Name="SimulationScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="SimulationCanvas"               
                              Width="3000"              
                              Height="3000"                
                              Background="#2B2B2B">

                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="SimulationScale"
                                          ScaleX="1"
                                          ScaleY="1"/>
                            </Canvas.LayoutTransform>
                            <ContentControl x:Name="SimulationHost" />

                        </Canvas>

                    </ScrollViewer>

                </GroupBox>

                <!-- 우측 Properties -->
                <GroupBox Header="Properties"          
                          Grid.Column="2"         
                          Margin="5">

                    <DataGrid      
                        x:Name="PropertyGrid"    
                        AutoGenerateColumns="False"     
                        HeadersVisibility="None"       
                        IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Binding="{Binding Name}"
                                Width="100"/>

                            <DataGridTextColumn
                                Binding="{Binding Value}"
                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

                <!-- 기존 내용 -->

            </Grid>


            <!-- Debug 창 -->
            <GroupBox       
                Grid.Row="1"        
                Header="Debug Output"        
                Margin="5">

                <TextBox          
                    x:Name="DebugOutput"    
                    Background="#1E1E1E"           
                    Foreground="White"           
                    IsReadOnly="True"          
                    TextWrapping="Wrap"           
                    VerticalScrollBarVisibility="Auto"/>

            </GroupBox>
        </Grid>
    </DockPanel>


</Window>