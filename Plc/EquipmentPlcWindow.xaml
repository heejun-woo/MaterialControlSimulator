<Window x:Class="MaterialControlSimulator.EquipmentPlcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment HMI"
        Width="1000"
        Height="850"
        MinWidth="800"
        MinHeight="600"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10" >

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="10"
                Margin="0,0,0,10"
                BorderThickness="1"
                CornerRadius="5"
                BorderBrush="Gray">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Equipment : "
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PlcNameText"/>

                    <TextBlock Text="   MC Port : "
                               Margin="20,0,0,0"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="PortText"/>

                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="● RUNNING"
                           FontWeight="Bold"/>

            </Grid>
        </Border>

        <!-- Main -->
        <TabControl Grid.Row="1">

            <!-- ============================= -->
            <!-- HMI -->
            <!-- ============================= -->

            <TabItem Header="HMI">

                <Grid x:Name="HmiContainer"
                      Margin="10">

                    <!-- 설비별 HMI UserControl이 들어갈 위치 -->

                </Grid>

            </TabItem>


            <!-- ============================= -->
            <!-- PLC MONITOR -->
            <!-- ============================= -->

            <TabItem Header="PLC Monitor">

                <TabControl Margin="5">

                    <!-- BIT -->
                    <TabItem Header="BIT (B)">

                        <DataGrid x:Name="BitGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CellEditEnding="BitGrid_CellEditEnding">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Address"
                                    Binding="{Binding Address}"
                                    IsReadOnly="True"
                                    Width="150"/>

                                <DataGridCheckBoxColumn
                                    Header="Value"
                                    Binding="{Binding Value}"
                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </TabItem>


                    <!-- WORD -->
                    <TabItem Header="WORD (W)">

                        <DataGrid x:Name="WordGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CellEditEnding="WordGrid_CellEditEnding">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Address"
                                    Binding="{Binding Address}"
                                    IsReadOnly="True"
                                    Width="150"/>

                                <DataGridTextColumn
                                    Header="Value"
                                    Binding="{Binding Value}"
                                    Width="150"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </TabItem>

                </TabControl>

            </TabItem>

        </TabControl>

    </Grid>
</Window>
