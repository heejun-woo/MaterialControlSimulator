<Window x:Class="MaterialControlSimulator.CarrierHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MaterialControlSimulator"
        mc:Ignorable="d"
        Title="CarrierHistoryWindow" Height="450" Width="800">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 검색 -->
        <StackPanel
            Orientation="Horizontal"
            Margin="0,0,0,10">

            <TextBox
                x:Name="CarrierSearchText"
                Width="180"
                Height="30"
                Margin="0,0,8,0"/>

            <Button
                Content="조회"
                Width="70"
                Margin="0,0,8,0"
                Click="Search_Click"/>

            <Button
                Content="전체"
                Width="70"
                Click="All_Click"/>

        </StackPanel>

        <!-- History -->
        <DataGrid
            x:Name="HistoryGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Time"
                    Binding="{Binding Time,
                              StringFormat=yyyy-MM-dd HH:mm:ss}"
                    Width="180"/>

                <DataGridTextColumn
                    Header="Carrier"
                    Binding="{Binding CarrierId}"
                    Width="120"/>

                <DataGridTextColumn
                    Header="From"
                    Binding="{Binding FromNode}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="To"
                    Binding="{Binding ToNode}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="Event"
                    Binding="{Binding Event}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="Message"
                    Binding="{Binding Message}"
                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>
